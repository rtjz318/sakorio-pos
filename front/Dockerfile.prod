FROM node:20-alpine AS builder

WORKDIR /app

# Install git for commit hash generation (needed for build script)
RUN apk add --no-cache git

# Copy package files and npm config (supply chain: pinned deps, no install scripts)
COPY package*.json .npmrc ./

# Install dependencies (--ignore-scripts: no lifecycle scripts, supply chain hardening)
RUN npm ci --ignore-scripts

# Copy source code
COPY . .

# Accept commit hash as build arguments (Render/GitHub/CI can pass any of these)
# If not provided, the script will try git or use "unknown" in production.
ARG COMMIT_HASH=
ARG RENDER_GIT_COMMIT=
ARG GITHUB_SHA=
ENV COMMIT_HASH=${COMMIT_HASH}
ENV RENDER_GIT_COMMIT=${RENDER_GIT_COMMIT}
ENV GITHUB_SHA=${GITHUB_SHA}
ENV NODE_ENV=production

# Generate commit hash file (script will use CI env vars if git is not available)
RUN node scripts/get-commit-hash.js

# Build the application for production (static output)
RUN npm run build -- --configuration production-static

# Inject app version into built index.html for smoke test (landing page version check without login)
RUN node scripts/inject-version-into-index.js

# Production stage
FROM nginx:alpine

# Copy built files from builder
# Angular 17+ outputs to dist/front/browser for static builds
COPY --from=builder /app/dist/front/browser /usr/share/nginx/html

# Marketing sites: front/sites/<slug>/ → /usr/share/nginx/html/sites/<slug>/ (URLs /slug/)
COPY sites/ /usr/share/nginx/html/sites/
COPY scripts/generate-marketing-nginx-include.sh /docker-gen-marketing.sh
RUN chmod +x /docker-gen-marketing.sh \
  && mkdir -p /etc/nginx/snippets \
  && /docker-gen-marketing.sh > /etc/nginx/snippets/marketing-sites.generated.conf

# Shared security headers used by every nginx location that emits headers.
COPY security-headers.nginx /etc/nginx/snippets/security-headers.conf

# Copy custom Nginx configuration (includes marketing-sites.generated.conf)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy entrypoint script
COPY docker-entrypoint-prod.sh /docker-entrypoint-prod.sh
RUN chmod +x /docker-entrypoint-prod.sh

# Expose port
EXPOSE 80

# Use entrypoint to inject environment variables
ENTRYPOINT ["/docker-entrypoint-prod.sh"]

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
