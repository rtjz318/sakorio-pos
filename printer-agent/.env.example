API_BASE_URL=https://api.sakorio.com
PRINTER_AGENT_TOKEN=replace-with-token-created-in-sakorio
# network = WiFi/LAN printer by IP. bluetooth_serial = paired Bluetooth printer
# exposed by the OS as COM5, /dev/cu.*, /dev/rfcomm*, etc.
PRINTER_TRANSPORT=network
PRINTER_HOST=192.168.1.50
PRINTER_PORT=9100
PRINTER_ENCODING=cp437
# Bluetooth serial settings. Required only when PRINTER_TRANSPORT=bluetooth_serial.
PRINTER_SERIAL_PORT=COM5
PRINTER_SERIAL_BAUDRATE=9600
PRINTER_SERIAL_TIMEOUT_SECONDS=10
POLL_SECONDS=3
SOCKET_TIMEOUT_SECONDS=10
# Set true to verify receipt generation without a physical printer.
PRINTER_DRY_RUN=false
PRINT_OUTPUT_DIR=print-output
